#!/bin/bash
set -e

INSTALL_DIR="/opt/mcp-is"
CONF_DIR="/etc/mcp-is"
ENV_FILE="${CONF_DIR}/.env"
VERSION_FILE="${INSTALL_DIR}/VERSION"

# Create config directory
mkdir -p "${CONF_DIR}"

# Copy .env.example if .env doesn't exist
if [ ! -f "${ENV_FILE}" ]; then
    cp "${INSTALL_DIR}/.env.example" "${ENV_FILE}"
    echo ""
    echo "====================================="
    echo "  MCP IS installed!"
    echo "====================================="
    echo ""
    echo "  IMPORTANT: Edit configuration file:"
    echo "  sudo nano ${ENV_FILE}"
    echo ""
    echo "  Required settings:"
    echo "    REGISTRATION_ENABLED=false   # true = пользователи сами регистрируются (отдельный сервис)"
    echo "    INSALES_APP_KEY=             # идентификатор приложения InSales (необязательно)"
    echo "    INSALES_SECRET_KEY=          # секрет приложения InSales (необязательно)"
    echo ""
    echo "  Ключи магазина добавляются в веб-интерфейсе (раздел «Магазины»)."
    echo "  Лицензия BSL 1.1: коммерческое использование — только с согласия разработчика (chubuk@mail.ru)."
    echo ""
    echo "  Then start the service:"
    echo "  sudo systemctl start mcp-is"
    echo ""
else
    echo "Config file ${ENV_FILE} already exists, preserving."
fi

# Reload systemd
systemctl daemon-reload

# Enable service
systemctl enable mcp-is

# Start containers
echo ""
echo "Starting containers..."
cd "${INSTALL_DIR}"
docker compose up -d --remove-orphans

# Wait for database to be healthy
echo "Waiting for database..."
WAIT_COUNT=0
MAX_WAIT=30
while [ ${WAIT_COUNT} -lt ${MAX_WAIT} ]; do
    if docker compose exec -T db pg_isready -U admin -d mcp_is &>/dev/null; then
        echo "Database is ready."
        break
    fi
    sleep 2
    WAIT_COUNT=$((WAIT_COUNT + 1))
done

if [ ${WAIT_COUNT} -ge ${MAX_WAIT} ]; then
    echo "WARNING: Database not ready after ${MAX_WAIT} attempts"
fi

# Run migrations
echo ""
echo "Running database migrations..."
MIGRATIONS_FILE="${INSTALL_DIR}/internal/storage/migrations.sql"
if [ -f "${MIGRATIONS_FILE}" ]; then
    docker compose exec -T db psql -U admin -d mcp_is -f /dev/stdin < "${MIGRATIONS_FILE}" 2>/dev/null && \
        echo "Migrations applied successfully." || \
        echo "WARNING: Some migrations may have failed (this is normal for first install)"
else
    echo "No migrations file found, skipping."
fi

# Health check
echo ""
echo "Running health check..."
sleep 3
HEALTH_URL="http://localhost:8080/health"
if curl -sf "${HEALTH_URL}" >/dev/null 2>&1; then
    echo "Health check passed."
else
    echo "WARNING: Health check failed. Service may need manual configuration."
    echo "  Check logs: docker compose -f ${INSTALL_DIR}/docker-compose.yaml logs"
fi

# Save version
NEW_VERSION=$(dpkg -s mcp-is 2>/dev/null | grep "^Version:" | awk '{print $2}' || echo "unknown")
echo "${NEW_VERSION}" > "${VERSION_FILE}"

echo ""
echo "====================================="
echo "  MCP IS update complete!"
echo "====================================="
echo ""
echo "  Version: ${NEW_VERSION}"
echo "  Config:  ${ENV_FILE}"
echo "  Logs:    docker compose -f ${INSTALL_DIR}/docker-compose.yaml logs -f"
echo ""
