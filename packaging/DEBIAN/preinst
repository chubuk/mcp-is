#!/bin/bash
set -e

INSTALL_DIR="/opt/mcp-is"
CONF_DIR="/etc/mcp-is"
ENV_FILE="${CONF_DIR}/.env"
VERSION_FILE="${INSTALL_DIR}/VERSION"
BACKUP_DIR="${INSTALL_DIR}/backups"

# Check Docker is installed
if ! command -v docker &> /dev/null; then
    echo "ERROR: Docker is not installed. Install docker.io first:"
    echo "  sudo apt install docker.io"
    exit 1
fi

# Check Docker is running
if ! docker info &> /dev/null; then
    echo "WARNING: Docker daemon is not running. Starting..."
    systemctl start docker || true
fi

# Check if this is an update or fresh install
if [ -f "${VERSION_FILE}" ]; then
    CURRENT_VERSION=$(cat "${VERSION_FILE}")
    NEW_VERSION=$(dpkg -s mcp-is 2>/dev/null | grep "^Version:" | awk '{print $2}' || echo "unknown")

    echo ""
    echo "====================================="
    echo "  MCP IS Update"
    echo "====================================="
    echo ""
    echo "  Current version: ${CURRENT_VERSION}"
    echo "  New version:     ${NEW_VERSION}"
    echo ""

    if [ "${CURRENT_VERSION}" = "${NEW_VERSION}" ]; then
        echo "  Same version. Skipping backup."
        echo ""
    else
        echo "  This will update MCP IS."
        echo ""
        read -p "  Create backup before update? [Y/n]: " CREATE_BACKUP
        CREATE_BACKUP=${CREATE_BACKUP:-Y}

        if [[ "${CREATE_BACKUP}" =~ ^[Yy]$ ]]; then
            echo ""
            echo "  Creating backup..."

            # Create backup directory
            mkdir -p "${BACKUP_DIR}"

            TIMESTAMP=$(date +%Y%m%d_%H%M%S)

            # Backup database if container is running
            if docker ps --format '{{.Names}}' | grep -q "mcp_is_db"; then
                echo "  Backing up database..."
                cd "${INSTALL_DIR}"
                docker compose exec -T db pg_dump -U admin mcp_is > "${BACKUP_DIR}/db_${TIMESTAMP}.sql" 2>/dev/null || true
                if [ -s "${BACKUP_DIR}/db_${TIMESTAMP}.sql" ]; then
                    echo "  Database backup: ${BACKUP_DIR}/db_${TIMESTAMP}.sql"
                else
                    echo "  WARNING: Database backup is empty or failed"
                    rm -f "${BACKUP_DIR}/db_${TIMESTAMP}.sql"
                fi
            else
                echo "  WARNING: Database container not running, skipping DB backup"
            fi

            # Backup project files
            echo "  Backing up project files..."
            cd "${INSTALL_DIR}"
            tar czf "${BACKUP_DIR}/files_${TIMESTAMP}.tar.gz" \
                --exclude='backups' \
                --exclude='.env' \
                internal/ web/ docker-compose.yaml Dockerfile .env.example 2>/dev/null || true

            if [ -s "${BACKUP_DIR}/files_${TIMESTAMP}.tar.gz" ]; then
                echo "  Files backup: ${BACKUP_DIR}/files_${TIMESTAMP}.tar.gz"
            else
                echo "  WARNING: Files backup failed"
            fi

            echo ""
            echo "  Backup completed."
            echo ""
        else
            echo "  Skipping backup."
            echo ""
        fi
    fi
fi

# Stop service if running
if systemctl is-active --quiet mcp-is 2>/dev/null; then
    echo "Stopping mcp-is service..."
    systemctl stop mcp-is
fi

exit 0
