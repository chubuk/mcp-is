# Database
# Пароль генерируется автоматически deploy.sh
DB_PASSWORD=CHANGE_ME

# Server
SERVER_PORT=8080
LOG_LEVEL=info

# InSales — приложение (install/uninstall/autologin). Оба обязательны для app-режима.
# Идентификатор = Basic-auth login при запросах от имени приложения (общий на все магазины).
# Секрет — из карточки приложения «Приложения → Разработчикам» (никому не сообщать).
INSALES_APP_KEY=
INSALES_SECRET_KEY=

# Security: запрет на редактирование данных (true = только чтение)
MCP_READ_ONLY=true

# Публичная регистрация (false = только админ создаёт пользователей).
# При пустой базе первый пользователь всё равно может зарегистрироваться (bootstrap super_admin).
# Если ставите mcp-is как отдельный сервис и хотите, чтобы пользователи сами регистрировались на сайте — поставьте true.
REGISTRATION_ENABLED=false
# RUB/month for InSales app mode; 0 = free (default)
BILLING_MONTHLY=0

# Авто-защита ПДн (true = автоматически включать для РФ магазинов + иностранных LLM)
PDN_AUTO_PROTECT=true
# Страна расположения сервера (RU, KZ, BY, INTL)
SERVER_COUNTRY=RU

# Auth: JWT secret (генерируется автоматически deploy.sh)
JWT_SECRET=CHANGE_ME

# Auth: JWT token expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24

# Auth: AES-GCM key для шифрования паролей InSales (генерируется deploy.sh)
ENCRYPTION_KEY=CHANGE_ME

# CORS: разрешённые домены (через запятую)
ALLOWED_ORIGINS=https://mcp-is.ru

# Domain (для HTTPS и email ссылок)
DOMAIN=mcp-is.example.com
LETSENCRYPT_EMAIL=admin@example.com

# SMTP (для отправки писем, опционально)
# Порт: 465 = SSL, 587 = STARTTLS. Можно менять в админке (/admin/email) без рестарта.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MCP IS <noreply@your-domain.com>

# Backup (базовые настройки, перезаписываются админкой)
BACKUP_ENABLED=true
BACKUP_DIR=/opt/mcp-is/backups
BACKUP_METHOD=pg_basebackup
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Блокировка AI-ботов (GPTBot, CCBot, Anthropic-AI и др.)
BLOCK_AI_BOTS=true

# Блокировка поисковых ботов (Googlebot, Bingbot, Yandex и др.)
# ОСТОРОЖНО: блокировка Googlebot ухудшит SEO!
BLOCK_SEARCH_BOTS=false
