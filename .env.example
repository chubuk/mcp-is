# Database
# Пароль генерируется автоматически deploy.sh
DB_PASSWORD=CHANGE_ME

# Server
SERVER_PORT=8080
LOG_LEVEL=info

# InSales (legacy, можно не заполнять если используете API через UI)
INSALES_SHOP=your-shop.myinsales.ru
INSALES_API_KEY=your_api_key_here
INSALES_PASSWORD=your_password_here

# Security: запрет на редактирование данных (true = только чтение)
MCP_READ_ONLY=true

# Авто-защита ПДн (true = автоматически включать для РФ магазинов + иностранных LLM)
PDN_AUTO_PROTECT=true
# Страна расположения сервера (RU, KZ, BY, INTL)
SERVER_COUNTRY=RU

# Auth: JWT secret (генерируется автоматически deploy.sh)
JWT_SECRET=CHANGE_ME

# Auth: JWT token expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24

# Auth: AES-GCM key для шифрования паролей InSales (генерируется deploy.sh)
ENCRYPTION_KEY=CHANGE_ME

# CORS: разрешённые домены (через запятую)
ALLOWED_ORIGINS=https://mcp-is.ru

# Domain (для HTTPS и email ссылок)
DOMAIN=mcp-is.example.com
LETSENCRYPT_EMAIL=admin@example.com

# SMTP (для отправки писем, опционально)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MCP IS <noreply@your-domain.com>

# Backup (базовые настройки, перезаписываются админкой)
BACKUP_ENABLED=true
BACKUP_DIR=/opt/mcp-is/backups
BACKUP_METHOD=pg_basebackup
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
